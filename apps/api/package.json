{
  "name": "@gpcsk/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:seed": "dotenv -e ../../.env -- tsx src/seed/index.ts",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "rag:ingest": "dotenv -e ../../.env -- tsx src/rag/ingest.ts",
    "rag:ingest-pdfs": "dotenv -e ../../.env -- tsx src/rag/ingest-pdfs.ts",
    "ingest:aaqm": "dotenv -e ../../.env -- tsx src/ingest/aaqm.ts",
    "ingest:cems": "dotenv -e ../../.env -- tsx src/ingest/cems.ts"
  },
  "dependencies": {
    "@gpcsk/shared": "workspace:*",
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "cheerio": "^1.0.0",
    "cors": "2.8.5",
    "express": "4.21.1",
    "jsonwebtoken": "9.0.2",
    "node-cron": "^3.0.3",
    "openai": "^4.73.0",
    "pdf-parse": "^1.1.1",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node-cron": "^3.0.11",
    "@types/pdf-parse": "^1.1.4",
    "@types/supertest": "6.0.2",
    "dotenv-cli": "7.4.2",
    "pino-pretty": "11.3.0",
    "prisma": "5.22.0",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.5.4",
    "vitest": "2.1.4"
  }
}
