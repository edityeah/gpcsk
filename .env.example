# === Database ===
DATABASE_URL=postgresql://gpcsk:gpcsk_dev@localhost:5434/gpcsk?schema=public

# === API ===
API_PORT=8001
API_JWT_SECRET=replace-me-in-prod-32-bytes-min
API_JWT_TTL_HOURS=24
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# === Web ===
VITE_API_URL=http://localhost:8001

# === OpenAI (Slice 7 — RAG + chat + voice) ===
OPENAI_API_KEY=sk-...

# === Live data (WAQI republishes CPCB CAAQMS hourly) ===
WAQI_TOKEN=
ENABLE_LIVE_INGEST=true

# === Deployment (Slice 8 — Cloudflare Tunnel) ===
PUBLIC_HOSTNAME=gpcsk.example.com

